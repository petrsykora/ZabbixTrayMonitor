<Window x:Class="ZabbixTrayMonitor.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="About - Zabbix Monitor"
        Icon="/Assets/tray-ok.ico"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        KeyDown="Window_KeyDown">

    <!-- Standarddialog von Windows: Titelleiste mit Schließen, Schrift nach Systemeinstellung -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name und Beschreibung -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <Image Source="/Assets/tray-ok.ico"
                   Width="32"
                   Height="32"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
            <TextBlock x:Name="AppNameText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{x:Static res:Strings.About_Description}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <!-- Details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style x:Key="LabelStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    <Setter Property="Margin" Value="0,0,16,6" />
                </Style>
                <Style x:Key="ValueStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
                <Style TargetType="Hyperlink">
                    <Setter Property="Foreground" Value="{DynamicResource LoadingBrush}" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_Version}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="VersionText" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_BasedOn}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="BasedOnText" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_ChangesBy}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="ChangesByText" />

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_License}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="LicenseText" />

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_Program}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="ProgramText" />

            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="{x:Static res:Strings.About_Config}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueStyle}" x:Name="ConfigText" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Tray_Help}"
                    MinWidth="90"
                    Click="Help_Click" />
            <Button Content="{x:Static res:Strings.Common_Close}"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
