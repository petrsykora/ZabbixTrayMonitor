<Window x:Class="ZabbixTrayMonitor.Views.SuppressUntilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="{x:Static res:Strings.Suppress_Title}"
        SizeToContent="WidthAndHeight"
        MinWidth="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource AppFontSize}"
        KeyDown="Window_KeyDown">

    <!-- Standarddialog von Windows: Titelleiste mit Schließen, Schrift nach Systemeinstellung -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="86" />
            <ColumnDefinition Width="*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="{x:Static res:Strings.Suppress_Date}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,8,8"
                   VerticalAlignment="Center" />

        <DatePicker x:Name="DatePicker"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    SelectedDateFormat="Short"
                    VerticalContentAlignment="Center"
                    DateValidationError="DatePicker_DateValidationError" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="{x:Static res:Strings.Suppress_Time}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center" />

        <TextBox x:Name="TimeTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 MaxLength="5"
                 VerticalContentAlignment="Center"
                 ToolTip="{x:Static res:Strings.Suppress_TimeFormat}"
                 PreviewTextInput="TimeTextBox_PreviewTextInput" />

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="{x:Static res:Strings.Common_Cancel}"
                    MinWidth="90"
                    Click="Cancel_Click" />

            <Button Content="{x:Static res:Strings.Suppress_Button}"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="Suppress_Click" />
        </StackPanel>
    </Grid>
</Window>
