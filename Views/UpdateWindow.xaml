<Window x:Class="ZabbixTrayMonitor.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="Update - Zabbix Monitor"
        Icon="/Assets/app.ico"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource AppFontSize}"
        KeyDown="Window_KeyDown">

    <!-- Hinweis auf eine neue Version: Installieren (herunterladen, prüfen, installieren), Herunterladen (Release-Seite im
         Browser), Version überspringen oder später erinnern -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Image Source="/Assets/app.ico"
                   Width="32"
                   Height="32"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Update_Heading}"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static res:Strings.Update_CurrentVersion}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,16,4" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       x:Name="CurrentVersionText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Static res:Strings.Update_NewVersion}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,16,0" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       x:Name="NewVersionText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Bold" />
        </Grid>

        <!-- Text hängt davon ab, ob die Anwendung selbst installieren kann (installierte Version) oder nur die ZIP-Version ist -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,14">
            <TextBlock x:Name="DescriptionText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ProgressText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <!-- Herunterladen, prüfen und installieren; nur sichtbar für die installierte Anwendung -->
            <Button x:Name="InstallButton"
                    Content="{x:Static res:Strings.Update_Install}"
                    MinWidth="90"
                    Padding="10,2"
                    Margin="0,0,8,0"
                    Click="Install_Click" />
            <Button x:Name="DownloadButton"
                    Content="{x:Static res:Strings.Update_Download}"
                    MinWidth="90"
                    Padding="10,2"
                    Click="Download_Click" />
            <Button x:Name="SkipButton"
                    Content="{x:Static res:Strings.Update_Skip}"
                    MinWidth="90"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    Click="Skip_Click" />
            <Button x:Name="LaterButton"
                    Content="{x:Static res:Strings.Update_Later}"
                    MinWidth="90"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="Later_Click" />
        </StackPanel>
    </Grid>
</Window>
