<Window x:Class="ZabbixTrayMonitor.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="Update - Zabbix Monitor"
        Icon="/Assets/app.ico"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource AppFontSize}"
        KeyDown="Window_KeyDown">

    <!-- Hinweis auf eine neue Version: Herunterladen (Release-Seite im Browser), Version überspringen oder später erinnern -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Image Source="/Assets/app.ico"
                   Width="32"
                   Height="32"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Update_Heading}"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static res:Strings.Update_CurrentVersion}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,16,4" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       x:Name="CurrentVersionText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Static res:Strings.Update_NewVersion}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,16,0" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       x:Name="NewVersionText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontWeight="Bold" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{x:Static res:Strings.Update_Description}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.Update_Download}"
                    MinWidth="90"
                    Padding="10,2"
                    IsDefault="True"
                    Click="Download_Click" />
            <Button Content="{x:Static res:Strings.Update_Skip}"
                    MinWidth="90"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    Click="Skip_Click" />
            <Button Content="{x:Static res:Strings.Update_Later}"
                    MinWidth="90"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="Later_Click" />
        </StackPanel>
    </Grid>
</Window>
