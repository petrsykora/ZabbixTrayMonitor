<Window x:Class="ZabbixTrayMonitor.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="Help - Zabbix Monitor"
        Icon="/Assets/app.ico"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource AppFontSize}"
        KeyDown="Window_KeyDown">

    <!-- Standardfenster von Windows: links die Kapitel, rechts der Inhalt des gewählten Kapitels.
         Die Kapitel werden in HelpWindow.xaml.cs aus den Strings-Ressourcen aufgebaut, die Hilfe ist vollständig offline -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="TopicsListBox"
                 Grid.Row="0"
                 Grid.Column="0"
                 Margin="0,0,16,0"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="TopicsListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <!-- Eigenes Template, damit die Auswahl auch im Dark Mode gut lesbar ist -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ReadOnlyInputBackgroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TopicTitleText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="{DynamicResource AppFontSizeTitle}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <!-- Fließtext etwas größer als die übrige Oberfläche, damit längere Texte gut lesbar sind -->
                <TextBlock x:Name="TopicText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="{DynamicResource AppFontSizeLarge}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Content="{x:Static res:Strings.Common_Close}"
                MinWidth="90"
                Click="Close_Click" />
    </Grid>
</Window>
