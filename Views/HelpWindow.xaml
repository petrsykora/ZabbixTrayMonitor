<Window x:Class="ZabbixTrayMonitor.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ZabbixTrayMonitor.Resources"
        Title="Help - Zabbix Monitor"
        Icon="/Assets/tray-ok.ico"
        Width="620"
        Height="640"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        KeyDown="Window_KeyDown">

    <!-- Standardfenster von Windows, Kapitel werden in HelpWindow.xaml.cs aus den Strings-Ressourcen aufgebaut -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsPanel"
                        Margin="16,12,16,8" />
        </ScrollViewer>

        <Grid Grid.Row="1"
              Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center">
                <Hyperlink x:Name="DocumentationLink"
                           Foreground="{DynamicResource LoadingBrush}"
                           Click="DocumentationLink_Click">
                    <Run Text="{x:Static res:Strings.Help_OnlineDocumentation}" />
                </Hyperlink>
            </TextBlock>

            <Button Grid.Column="1"
                    Content="{x:Static res:Strings.Common_Close}"
                    MinWidth="90"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
