<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- Restore/Build auch auf Linux erlauben (zB. GitHub Automatic Dependency Submission) -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<Version>1.3.3</Version>
		<AssemblyVersion>1.3.3.0</AssemblyVersion>
		<FileVersion>1.3.3.0</FileVersion>
		<InformationalVersion>1.3.3</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<Product>ZabbixTrayMonitor</Product>
		<Title>Zabbix Tray Monitor</Title>
		<Description>Small Windows tray client for Zabbix</Description>
		<Company>Darano94</Company>
		<Authors>Darano94, Petr Sýkora</Authors>
		<Copyright>Copyright © 2026 Darano94, Petr Sýkora</Copyright>

		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\tray-error.ico" />
		<None Remove="Assets\app.ico" />
		<None Remove="Assets\tray-ok.ico" />
		<None Remove="Assets\tray-unknown.ico" />
		<None Remove="Assets\tray-warning.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- Übersetzungen: Strings.resx = Englisch (Fallback), Strings.de.resx = Deutsch, Strings.cs.resx = Tschechisch
		     Strings.Designer.cs wird von Visual Studio beim Speichern von Strings.resx neu generiert -->
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<!-- MIT-Lizenz verlangt, dass Copyright und Lizenztext jeder Kopie beiliegen:
		     als LICENSE.txt neben der exe (ZIP und MSI) und eingebettet für die Anzeige im Info-Fenster -->
		<None Update="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<EmbeddedResource Include="LICENSE" LogicalName="ZabbixTrayMonitor.LICENSE" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CredentialManagement" Version="1.0.2" />
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\tray-error.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\app.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\tray-ok.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\tray-unknown.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Assets\tray-warning.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

</Project>