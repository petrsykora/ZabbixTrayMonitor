<!--
	MSI-Paket für ZabbixTrayMonitor

	- Installation pro Computer nach "C:\Program Files\ZabbixTrayMonitor" (für GPO-Softwareverteilung / Intune geeignet)
	- Startmenü-Verknüpfung und Autostart für alle Benutzer (Autostart abschaltbar mit: msiexec /i ZabbixTrayMonitor.msi AUTOSTART=0)
	- Neue Versionen ersetzen ältere automatisch (MajorUpgrade), eine laufende Instanz wird vorher beendet
	- config.json und API Token im Credential Manager liegen beim Benutzer und bleiben beim Deinstallieren erhalten
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<!-- UpgradeCode darf sich nie ändern, sonst werden alte Versionen nicht mehr ersetzt -->
	<Package Name="Zabbix Tray Monitor"
	         Manufacturer="ZabbixTrayMonitor"
	         Version="$(var.ProductVersion)"
	         UpgradeCode="8C296249-5391-4A2B-95F1-7A64EBA18FCC"
	         Scope="perMachine"
	         Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<Icon Id="AppIcon" SourceFile="$(var.AssetsDir)\tray-ok.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon" />

		<!-- 1 = Autostart für alle Benutzer einrichten, 0 = nicht -->
		<Property Id="AUTOSTART" Value="1" Secure="yes" />

		<Feature Id="Main">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentRef Id="AutostartRegistry" />
		</Feature>

		<!-- Laufende Instanz vor Update/Deinstallation beenden, sonst sind die Dateien gesperrt -->
		<util:CloseApplication Id="CloseRunningApp"
		                       Target="ZabbixTrayMonitor.exe"
		                       CloseMessage="no"
		                       TerminateProcess="1"
		                       RebootPrompt="no" />
	</Package>

	<Fragment>
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ZabbixTrayMonitor" />
		</StandardDirectory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<!-- exe separat, damit die Startmenü-Verknüpfung darauf zeigen kann -->
			<Component>
				<File Id="MainExe" Source="$(var.PublishDir)\ZabbixTrayMonitor.exe" KeyPath="yes">
					<Shortcut Id="StartMenuShortcut"
					          Directory="ProgramMenuFolder"
					          Name="Zabbix Tray Monitor"
					          WorkingDirectory="INSTALLFOLDER"
					          Icon="AppIcon"
					          Advertise="yes" />
				</File>
			</Component>

			<!-- alle übrigen Dateien aus dem Publish-Ordner (self-contained .NET Runtime, Sprachdateien) -->
			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ZabbixTrayMonitor.exe" />
				<Exclude Files="$(var.PublishDir)\**\*.pdb" />
			</Files>
		</ComponentGroup>
	</Fragment>

	<Fragment>
		<Component Id="AutostartRegistry" Directory="INSTALLFOLDER" Condition="AUTOSTART = &quot;1&quot;">
			<RegistryValue Root="HKLM"
			               Key="Software\Microsoft\Windows\CurrentVersion\Run"
			               Name="ZabbixTrayMonitor"
			               Value="&quot;[INSTALLFOLDER]ZabbixTrayMonitor.exe&quot;"
			               Type="string"
			               KeyPath="yes" />
		</Component>
	</Fragment>

</Wix>
