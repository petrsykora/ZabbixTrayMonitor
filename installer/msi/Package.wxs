<!--
	MSI-Paket für ZabbixTrayMonitor

	- Installation pro Computer nach "C:\Program Files\ZabbixTrayMonitor" (für GPO-Softwareverteilung / Intune geeignet)
	- Startmenü-Verknüpfung und Autostart für alle Benutzer (Autostart abschaltbar mit: msiexec /i ZabbixTrayMonitor.msi AUTOSTART=0)
	- Neue Versionen ersetzen ältere automatisch (MajorUpgrade), eine laufende Instanz wird vorher beendet
	- config.json und API Token im Credential Manager liegen beim Benutzer und bleiben beim Deinstallieren erhalten
	- Variante RuntimeDependent: ohne .NET Runtime, Installation nur wenn die .NET 10 Desktop Runtime (x64) vorhanden ist
	  (setup.exe aus installer/bundle installiert die Runtime bei Bedarf vorher)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<!-- UpgradeCode darf sich nie ändern, sonst werden alte Versionen nicht mehr ersetzt -->
	<Package Name="Zabbix Monitor"
	         Manufacturer="ZabbixTrayMonitor"
	         Version="$(var.ProductVersion)"
	         UpgradeCode="8C296249-5391-4A2B-95F1-7A64EBA18FCC"
	         Scope="perMachine"
	         Compressed="yes">

		<!-- beide Varianten haben denselben UpgradeCode und ersetzen sich gegenseitig, auch bei gleicher Version -->
		<MajorUpgrade AllowSameVersionUpgrades="yes"
		              DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<!-- Standarddialoge mit Lizenzbedingungen (MIT), bei stiller Installation (/qn) werden keine Dialoge angezeigt -->
		<ui:WixUI Id="WixUI_Minimal" />
		<WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

		<Icon Id="AppIcon" SourceFile="$(var.AssetsDir)\tray-ok.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon" />

<?if $(var.InstallerVariant) = "RuntimeDependent" ?>
		<!-- .NET 10 Desktop Runtime (x64) suchen: PresentationFramework.dll mit Dateiversion 10.x in einem Unterordner von
		     C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App -->
		<Property Id="DOTNETDESKTOP10">
			<DirectorySearch Id="DotNetWindowsDesktopApp"
			                 Path="[ProgramFiles64Folder]dotnet\shared\Microsoft.WindowsDesktop.App"
			                 Depth="1">
				<FileSearch Name="PresentationFramework.dll"
				            MinVersion="10.0.0.0"
				            MaxVersion="10.65535.65535.65535" />
			</DirectorySearch>
		</Property>

		<Launch Condition="Installed OR DOTNETDESKTOP10"
		        Message="Zabbix Monitor requires the .NET 10 Desktop Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/10.0, or use the setup.exe that installs it automatically, or the installer that already contains the runtime." />
<?endif?>

		<!-- 1 = Autostart für alle Benutzer einrichten, 0 = nicht -->
		<Property Id="AUTOSTART" Value="1" Secure="yes" />

		<Feature Id="Main">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentRef Id="AutostartRegistry" />
		</Feature>

		<!-- Laufende Instanz vor Update/Deinstallation beenden, sonst sind die Dateien gesperrt -->
		<util:CloseApplication Id="CloseRunningApp"
		                       Target="ZabbixTrayMonitor.exe"
		                       CloseMessage="no"
		                       TerminateProcess="1"
		                       RebootPrompt="no" />
	</Package>

	<Fragment>
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ZabbixTrayMonitor" />
		</StandardDirectory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<!-- exe separat, damit die Startmenü-Verknüpfung darauf zeigen kann (Icon kommt aus der exe) -->
			<Component>
				<File Id="MainExe" Source="$(var.PublishDir)\ZabbixTrayMonitor.exe" KeyPath="yes">
					<Shortcut Id="StartMenuShortcut"
					          Directory="ProgramMenuFolder"
					          Name="Zabbix Monitor"
					          WorkingDirectory="INSTALLFOLDER"
					          Advertise="yes" />
				</File>
			</Component>

			<!-- alle übrigen Dateien aus dem Publish-Ordner (self-contained .NET Runtime, Sprachdateien) -->
			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ZabbixTrayMonitor.exe" />
				<Exclude Files="$(var.PublishDir)\**\*.pdb" />
			</Files>
		</ComponentGroup>
	</Fragment>

	<Fragment>
		<Component Id="AutostartRegistry" Directory="INSTALLFOLDER" Condition="AUTOSTART = &quot;1&quot;">
			<RegistryValue Root="HKLM"
			               Key="Software\Microsoft\Windows\CurrentVersion\Run"
			               Name="ZabbixTrayMonitor"
			               Value="&quot;[INSTALLFOLDER]ZabbixTrayMonitor.exe&quot;"
			               Type="string"
			               KeyPath="yes" />
		</Component>
	</Fragment>

</Wix>
