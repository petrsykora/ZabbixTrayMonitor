<Project Sdk="WixToolset.Sdk/5.0.2">

	<!--
		MSI-Installer für ZabbixTrayMonitor (WiX Toolset v5, baut nur unter Windows)

		Zwei Varianten aus demselben Projekt:
		  SelfContained     .NET Runtime ist im Publish-Ordner enthalten (Standard)
		  RuntimeDependent  benötigt installierte .NET 10 Desktop Runtime (x64), prüft das per Launch Condition

		Beispiel:
		  dotnet publish ..\..\ZabbixTrayMonitor.csproj -c Release -r win-x64 -self-contained true -o ..\..\publish
		  dotnet build ZabbixTrayMonitor.Installer.wixproj -c Release -p:ProductVersion=1.3.2
		  dotnet publish ..\..\ZabbixTrayMonitor.csproj -c Release -r win-x64 -self-contained false -o ..\..\publish-runtime-dependent
		  dotnet build ZabbixTrayMonitor.Installer.wixproj -c Release -p:ProductVersion=1.3.2 -p:InstallerVariant=RuntimeDependent -p:PublishDir=..\..\publish-runtime-dependent
	-->

	<PropertyGroup>
		<InstallerVariant Condition="'$(InstallerVariant)' == ''">SelfContained</InstallerVariant>
		<OutputName Condition="'$(InstallerVariant)' == 'RuntimeDependent'">ZabbixTrayMonitor-RuntimeDependent</OutputName>
		<OutputName Condition="'$(InstallerVariant)' != 'RuntimeDependent'">ZabbixTrayMonitor</OutputName>
		<InstallerPlatform>x64</InstallerPlatform>
		<ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
		<!-- Lizenztext für den Lizenzdialog, wird aus LICENSE erzeugt: tools\New-LicenseRtf.ps1 -->
		<LicenseRtf Condition="'$(LicenseRtf)' == ''">$(MSBuildProjectDirectory)\..\License.rtf</LicenseRtf>
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\..\..\publish</PublishDir>
		<DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(MSBuildProjectDirectory)\..\..\Assets;InstallerVariant=$(InstallerVariant);LicenseRtf=$(LicenseRtf)</DefineConstants>

		<!-- getrennte Ausgabe- und Zwischenordner je Variante, damit sich die Builds nicht gegenseitig überschreiben -->
		<OutputPath>bin\$(Configuration)\$(InstallerVariant)\</OutputPath>
		<IntermediateOutputPath>obj\$(Configuration)\$(InstallerVariant)\</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
	</ItemGroup>

</Project>
